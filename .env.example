# ══════════════════════════════════════════════════════════════════════════════
# YOLIK.MX — Variables de Entorno
#
# Copia este archivo:  cp .env.example .env
# Llena los valores en .env  —  NUNCA lo commitees al repositorio
#
# Tipos de variables:
#   [BUILD]   Se inyectan al compilar Angular (baked in el bundle JS)
#   [RUNTIME] Se leen en ejecución por el servidor Node
# ══════════════════════════════════════════════════════════════════════════════


# ── FRONTEND ANGULAR ─────────────────────────────────────────────────────────
# Estas variables se pasan como --build-arg a Docker y se hornean en el bundle.
# Si las cambias, debes RECONSTRUIR la imagen (docker compose build frontend).

# [BUILD] URL base de la API — en producción apunta al proxy de nginx
API_URL=https://yolik.mx/api

# [BUILD] Auth0 — credenciales del tenant de frontend (SPA)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=

# [BUILD] Stripe — clave PÚBLICA (pk_live_...) — segura para exponer en cliente
STRIPE_PUBLISHABLE_KEY=


# ── BACKEND NEXT.JS ──────────────────────────────────────────────────────────
# Estas variables se inyectan en runtime al contenedor de Next.js.
# Puedes cambiarlas sin reconstruir la imagen (solo reiniciar el contenedor).

# [RUNTIME] Base de datos (PostgreSQL, MySQL, etc.)
DATABASE_URL=

# [RUNTIME] Auth0 — credenciales de servidor (distintas del frontend)
AUTH0_SECRET=                       # string aleatorio largo (openssl rand -hex 32)
AUTH0_BASE_URL=https://yolik.mx
AUTH0_ISSUER_BASE_URL=              # https://tu-tenant.us.auth0.com
AUTH0_CLIENT_ID_BACKEND=
AUTH0_CLIENT_SECRET=

# [RUNTIME] Stripe — clave SECRETA (sk_live_...) — NUNCA al frontend
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=              # whsec_... (desde Stripe Dashboard > Webhooks)
